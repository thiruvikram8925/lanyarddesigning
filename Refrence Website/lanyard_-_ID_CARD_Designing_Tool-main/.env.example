# ── Application Environment ──
NODE_ENV=production
PORT=4000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Security & Authentication ──
# Change JWT_SECRET to a strong random 64-character secret in production
JWT_SECRET=super-secret-production-key-change-me-immediately
ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=admin123

# ── Database Configuration ──
# MySQL connection string format: mysql://user:password@host:port/database
DATABASE_URL=mysql://root:password@localhost:3306/lanyard_db

# ── Cloud Storage (Cloudinary - Optional) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Virtual Try-On (HuggingFace) ──
# Uses HuggingFace Gradio space for free virtual try-on
VITE_API_URL=http://localhost:4000
